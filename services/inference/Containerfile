FROM docker.io/library/golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY go.sum ./
COPY services/inference ./services/inference
RUN go build -o /out/inference ./services/inference/cmd/inference

FROM docker.io/library/alpine:3.20
RUN adduser -D -H astracdn
USER astracdn
COPY --from=build /out/inference /usr/local/bin/inference
EXPOSE 8082
ENTRYPOINT ["/usr/local/bin/inference"]
