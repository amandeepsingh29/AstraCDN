ASTRACDN_ENV=local
# Local development key only. Override for any shared or production environment.
ASTRACDN_API_KEY=astracdn-local-dev-key
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_REQUEST_BODY_BYTES=1048576
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-AstraCDN-API-Key,X-AstraCDN-Billing-Signature,X-Request-ID
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

POSTGRES_DB=astracdn
POSTGRES_USER=astracdn
# Local development password only. Override outside local development.
POSTGRES_PASSWORD=astracdn_local_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_ADDR=redis:6379
NATS_URL=nats://nats:4222
CONTROL_BASE_URL=http://control:8081
CONTROL_API_KEY=astracdn-local-dev-key
CONTROL_DOMAIN_VERIFICATION_BYPASS=false
CONTROL_BILLING_WEBHOOK_SECRET=
EDGE_CONFIG_REFRESH_INTERVAL=15s
EDGE_DOMAIN_VALIDATION_ENABLED=false
EDGE_ANALYTICS_PUSH_INTERVAL=0s
EDGE_REQUEST_COALESCING_ENABLED=true
EDGE_WAF_ENABLED=false
EDGE_WAF_BLOCK_METHODS=
EDGE_WAF_BLOCK_PATH_PREFIXES=
EDGE_WAF_BLOCK_HEADERS=
EDGE_WAF_BLOCK_IPS=
EDGE_RESPONSE_SET_HEADERS=
EDGE_RESPONSE_REMOVE_HEADERS=
EDGE_REDIRECT_RULES=
EDGE_RATE_LIMIT_RULES=

EDGE_PORT=8080
EDGE_NODE_ID=edge-local-1
EDGE_PUBLIC_URL=http://edge:8080
EDGE_HEALTH_PUSH_INTERVAL=60s
EDGE_HEALTH_STALE_AFTER=2m
EDGE_INVALIDATION_ACK_ATTEMPTS=3
EDGE_INVALIDATION_ACK_BACKOFF=250ms
CONTROL_PORT=8081
CONTROL_AUDIT_LOG_ENABLED=true
CONTROL_OTLP_METRICS_ENDPOINT=
CONTROL_OTLP_HEADERS=
CONTROL_OTLP_EXPORT_TIMEOUT=5s
CONTROL_WAREHOUSE_JSONL_PATH=
INFERENCE_PORT=8082
DASHBOARD_PORT=3000
# Defaults to ASTRACDN_API_KEY when unset. Use a separate secret outside local development.
DASHBOARD_ACCESS_TOKEN=
DASHBOARD_CONTROL_BASE_URL=http://control:8081
DASHBOARD_EDGE_BASE_URL=http://edge:8080
DASHBOARD_INFERENCE_BASE_URL=http://inference:8082
DASHBOARD_PUBLIC_CDN_BASE_URL=http://cdn.localhost:8080
DASHBOARD_PROXY_TIMEOUT=10s
DASHBOARD_STORAGE_MODE=local
DASHBOARD_ASSET_DIR=/var/lib/astra-cdn/origin
DASHBOARD_MAX_UPLOAD_BYTES=104857600
DASHBOARD_S3_ENDPOINT=
DASHBOARD_S3_BUCKET=
DASHBOARD_S3_REGION=us-east-1
DASHBOARD_S3_ACCESS_KEY_ID=
DASHBOARD_S3_SECRET_ACCESS_KEY=
DASHBOARD_S3_SESSION_TOKEN=
DASHBOARD_S3_PREFIX=
DASHBOARD_S3_FORCE_PATH_STYLE=true
DASHBOARD_S3_TIMEOUT=30s
MINIO_ROOT_USER=astracdn
MINIO_ROOT_PASSWORD=astracdn-local-minio-secret
MINIO_BUCKET=astra-cdn-assets
MINIO_EXPIRE_DAYS=30
ORIGIN_BASE_URL=http://example-origin:9000
ORIGIN_STORAGE_MODE=local
ORIGIN_ASSET_DIR=/var/lib/astra-cdn/origin
ORIGIN_S3_ENDPOINT=
ORIGIN_S3_BUCKET=
ORIGIN_S3_REGION=us-east-1
ORIGIN_S3_ACCESS_KEY_ID=
ORIGIN_S3_SECRET_ACCESS_KEY=
ORIGIN_S3_SESSION_TOKEN=
ORIGIN_S3_PREFIX=
ORIGIN_S3_FORCE_PATH_STYLE=true
ORIGIN_S3_TIMEOUT=30s
EDGE_ORIGIN_SHIELD_URLS=
EDGE_ORIGIN_FAILOVER_URLS=
ORIGIN_CACHE_MAX_AGE=60
ORIGIN_LAST_MODIFIED=Sun, 24 May 2026 09:00:00 GMT
EDGE_ORIGIN_TIMEOUT=15s
EDGE_ORIGIN_ATTEMPTS=1
EDGE_ORIGIN_RETRY_BACKOFF=100ms
EDGE_SIGNING_ENABLED=false
# Required and must be at least 32 characters when EDGE_SIGNING_ENABLED=true.
EDGE_SIGNING_SECRET=
EDGE_SIGNED_COOKIE_ENABLED=false
EDGE_SIGNED_COOKIE_NAME=AstraCDN-Signature
EDGE_SIGNED_COOKIE_PATH_PREFIXES=
EDGE_REVALIDATION_MAX_STALE=24h
EDGE_COMPRESSION_ENABLED=true
EDGE_BROTLI_ENABLED=true
EDGE_COMPRESSION_MIN_BYTES=512
EDGE_LARGE_OBJECT_STREAMING_ENABLED=true
EDGE_LARGE_OBJECT_THRESHOLD_BYTES=8388608
EDGE_SEGMENTED_CACHE_ENABLED=true
EDGE_SEGMENT_SIZE_BYTES=1048576
EDGE_IMAGE_TRANSFORM_ENABLED=true
EDGE_IMAGE_TRANSFORM_MAX_DIMENSION=2048
EDGE_IMAGE_TRANSFORM_JPEG_QUALITY=82

INFERENCE_PROVIDER=openai
INFERENCE_MODEL=gpt-4o-mini
SEMANTIC_CACHE_ENABLED=false

# OpenAI Responses API mode. Replace with another compatible gateway if needed.
OPENAI_BASE_URL=https://api.openai.com/v1
# Do not commit a real API key. Export it in your shell or put it in an untracked .env.
OPENAI_API_KEY=
OPENAI_CLIENT=astra-cdn
OPENAI_CLIENT_VERSION=0

# Any OpenAI-compatible provider, including many local gateways.
OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
OPENAI_COMPAT_API_KEY=

# vLLM exposes an OpenAI-compatible API by default in common deployments.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=

# Ollama local API.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
