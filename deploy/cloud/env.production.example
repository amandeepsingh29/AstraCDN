export ASTRACDN_ENV=production

# Required: Kubernetes context and namespace for the core control-plane stack.
export KUBE_CONTEXT=replace-with-production-kube-context
export NAMESPACE=astra-cdn
export KUSTOMIZE_PATH=deploy/k8s/overlays/production

# Required when PUSH_IMAGES=true.
export IMAGE_REGISTRY=ghcr.io/your-org
export IMAGE_TAG=replace-with-immutable-release-tag

# Safety gates. Leave false for render/preflight only.
export APPLY=false
export PUSH_IMAGES=false
export RUN_DB_MIGRATIONS=false
export RUN_OPENTOFU=false
export DEPLOY_REGIONAL_EDGES=false

# OpenTofu global edge generation.
export OPENTOFU_DIR=deploy/opentofu
export OPENTOFU_VAR_FILE=examples/production.tfvars.example

# Optional regional edge apply mapping.
# Format: region=context,region=context
export REGIONAL_EDGE_CONTEXTS=us-east-1=replace-with-us-east-1-context,eu-west-1=replace-with-eu-west-1-context

# Public verification targets.
export CONTROL_URL=https://control.example.com
export CDN_URL=https://cdn.example.com
export DASHBOARD_URL=https://dashboard.example.com
export CDN_HOST=cdn.example.com
export PROBE_PATH=/edge/probe.txt

# Required for authenticated control-plane checks.
export ASTRACDN_API_KEY=replace-with-production-api-key
